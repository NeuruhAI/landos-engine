{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuruh.local/contracts/action-proposal.v1.json",
  "title": "ActionProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "created_at",
    "entity",
    "proposed_action",
    "authority",
    "cost",
    "reversibility",
    "expected_outcome",
    "downside",
    "prerequisites",
    "approval",
    "expiry",
    "receipt_links",
    "content_sha256"
  ],
  "properties": {
    "schema": { "const": "neuruh.action_proposal.v1" },
    "proposal_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "entity": { "type": "object" },
    "proposed_action": {
      "type": "string",
      "enum": [
        "enrich_skip_trace",
        "dial_owner",
        "sms_owner",
        "email_owner",
        "mail_offer",
        "set_offer_price",
        "create_contract",
        "assign_buyer",
        "promote_stage",
        "suppress_dnc",
        "score_rescore",
        "underwrite_refresh",
        "no_action"
      ]
    },
    "authority": {
      "type": "object",
      "required": ["propose_role", "approve_role_min", "execute_role_min", "tenant_id"],
      "properties": {
        "propose_role": { "type": "string" },
        "approve_role_min": { "type": "string" },
        "execute_role_min": { "type": "string" },
        "tenant_id": { "type": "string", "format": "uuid" },
        "capability_flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cost": {
      "type": "object",
      "required": ["usd", "minutes", "compliance_risk"],
      "properties": {
        "usd": { "type": "number", "minimum": 0 },
        "minutes": { "type": "number", "minimum": 0 },
        "compliance_risk": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        },
        "burn_rate_note": { "type": ["string", "null"] }
      }
    },
    "reversibility": {
      "type": "string",
      "enum": ["reversible", "partially_reversible", "irreversible"]
    },
    "expected_outcome": {
      "type": "object",
      "required": ["primary", "forecast_version", "confidence", "horizon_days"],
      "properties": {
        "primary": { "type": "string" },
        "predicted_values": { "type": "object" },
        "forecast_version": { "type": "string", "minLength": 1 },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "horizon_days": { "type": "integer", "minimum": 0 }
      }
    },
    "downside": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string" },
        "worst_case_usd": { "type": ["number", "null"] },
        "legal_risk": { "type": ["string", "null"] }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string" }
    },
    "approval": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "expired"]
        },
        "actor_role": { "type": ["string", "null"] },
        "actor_id_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "rejection_reason": { "type": ["string", "null"] }
      }
    },
    "expiry": { "type": "string", "format": "date-time" },
    "receipt_links": {
      "type": "object",
      "properties": {
        "underwriting_id": { "type": ["string", "null"], "format": "uuid" },
        "underwriting_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" }
        },
        "lead_receipt_chain_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "aegis_decision_id": { "type": ["string", "null"] }
      }
    },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
