# ============================================================
# LandOS Engine — environment template
# Copy this file to ".env" and fill in the real values.
#   cp .env.example .env
# The real .env is gitignored and must never be committed.
# ============================================================

# --- DATABASE_URL -------------------------------------------------
# Your Supabase Postgres connection string (Session pooler).
# Get it: Supabase dashboard -> select the "neuruh-axon" project ->
#   Project Settings (gear, bottom-left) -> Database ->
#   "Connection string" -> click the "Session pooler" tab -> copy the URI.
# It looks like the line below. Replace [YOUR-PASSWORD] with your database
# password (same Database settings page; click "Reset database password"
# if you don't have it saved). Copy the EXACT host from the dashboard —
# the region segment (e.g. us-east-1) may differ from this example.
DATABASE_URL=postgresql://postgres.lvdimujkfheeyqchjzra:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# DATABASE_URL is the ENGINE's database (schema landos, sync_to_crm). It is NOT the
# DeedSonar contact graph: the contact tools never read DATABASE_URL (no fallback),
# and refuse the legacy ref above wherever it appears.

# --- DEEDSONAR_DATABASE_URL ---------------------------------------
# The ONE database of the DeedSonar contact graph (candidate_contact_resolution,
# parties, party_phones, candidate_parties, contact_evidence, free_route_attempts).
# The ONLY env source the contact tools read (besides an explicit --database-url);
# unset -> CONTACT_DSN_MISSING (exit 2), even when DATABASE_URL is set.
# See app/contact_authority.py.
# Only DeedSonar Pro (efxowqudmsfqjmbeidjc) or a local replica is accepted.
# Supabase dashboard -> the DeedSonar Pro project -> Connect -> Session pooler URI.
DEEDSONAR_DATABASE_URL=postgresql://postgres.efxowqudmsfqjmbeidjc:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# --- LANDOS_SECRET ------------------------------------------------
# Shared secret that callers (your APG deployment) must send in the
# X-LANDOS-SECRET header. Generate a strong one in Terminal with:
#   openssl rand -hex 32
# Paste the output here, and put the SAME value in APG's environment.
LANDOS_SECRET=replace-with-output-of-openssl-rand-hex-32

# --- PORT ---------------------------------------------------------
# Local port the service listens on. 8400 keeps it clear of your
# other Neuruh services (AXON 8300, Bonsai 8100, Gemma 8200).
PORT=8400
